# 复制为 .env 后按需修改
# 数据库：默认使用 SQLite，开箱即用。
# 切换 PostgreSQL：把 provider 改成 postgresql，并改成形如：
# DATABASE_URL="postgresql://user:pass@localhost:5432/express_pickup?schema=public"
DATABASE_URL="file:./dev.db"

# JWT 密钥（生产环境务必替换为随机长字符串）
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="30d"

# 服务端口
PORT=3000

# 管理后台默认账号（seed 时创建）
ADMIN_EMAIL="admin@express.local"
ADMIN_PASSWORD="admin123456"

# 真实推送（FCM）。留空则推送降级为仅落库，不影响其它功能。
# 配置方法见 docs/PUSH.md
# FIREBASE_SERVICE_ACCOUNT="./firebase-service-account.json"
